<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GOJEK ELIT — Clean Pro</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<style>
:root{--green:#00a86b;--ink:#14211c;--muted:#738078;--line:#e7eee9;--bg:#f4f7f5;--white:#fff}
*{box-sizing:border-box}body{margin:0;background:var(--bg);font:15px/1.45 Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink)}
button,input{font:inherit}button{cursor:pointer;border:0}
.app{max-width:520px;margin:auto;min-height:100vh;background:var(--bg);padding-bottom:88px}
header{background:#10251d;color:#fff;padding:22px 20px 25px;border-radius:0 0 25px 25px}
.top{display:flex;align-items:center;justify-content:space-between}.brand{font-weight:900;letter-spacing:1.3px;font-size:20px}.brand span{color:#63e3a7}
.profile{display:flex;align-items:center;gap:8px;font-size:12px;color:#d4e2da}.avatar{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:#244b39;font-weight:700;color:#a8f1c9}
.greeting{margin-top:24px;font-size:13px;color:#b7c9bf}.headline{font-size:25px;font-weight:800;margin:4px 0 0;letter-spacing:-.5px}
main{padding:16px 15px}.card{background:var(--white);border:1px solid var(--line);border-radius:19px;padding:16px;margin-bottom:13px;box-shadow:0 5px 18px #10251d06}
.section-title{font-weight:800;font-size:14px;margin-bottom:13px;display:flex;justify-content:space-between;align-items:center}
.location-row{display:grid;grid-template-columns:12px minmax(0,1fr) 58px;gap:9px;align-items:start}.dots{display:flex;flex-direction:column;align-items:center;gap:5px}.dot{width:9px;height:9px;border-radius:50%;background:var(--green)}.dot.dest{background:#f5a623}.line{width:1px;height:24px;background:#d5e0d9}
.fields{min-width:0;display:grid;gap:9px}.field{display:flex;align-items:center;background:#f6f8f6;border:1px solid #edf1ee;border-radius:12px;padding:0 12px;height:45px;gap:8px}.field input{border:0;outline:0;background:transparent;width:100%;min-width:0;color:var(--ink)}.field input::placeholder{color:#9aa69f}
.gps{grid-column:3;grid-row:1;align-self:start;width:58px;height:45px;background:#e8f8ef;color:#087c4d;border-radius:11px;padding:8px 4px;font-size:12px;font-weight:800;white-space:nowrap}.search-destination{width:100%;height:42px;border-radius:11px;background:#10251d;color:#fff;font-size:13px;font-weight:800;margin-top:0}
.map-wrap{height:270px;border-radius:17px;overflow:hidden;position:relative;border:1px solid var(--line);background:#e9efeb}.map-actions{position:absolute;z-index:500;right:10px;top:10px;display:flex;gap:7px}.map-actions button{background:#fff;border-radius:10px;padding:9px 11px;font-size:11px;font-weight:800;box-shadow:0 3px 12px #0001}.map-note{position:absolute;z-index:500;left:10px;bottom:10px;background:#fff;border-radius:10px;padding:8px 10px;font-size:11px;color:#64736a;box-shadow:0 3px 12px #0001}
.vehicles{display:grid;grid-template-columns:1fr 1fr;gap:10px}.vehicle{border:1px solid var(--line);border-radius:15px;padding:13px;text-align:left;background:#fff}.vehicle.active{border:1.5px solid var(--green);background:#f0fbf5}.vehicle .emoji{font-size:25px}.vehicle strong{display:block;margin-top:5px}.vehicle small{color:var(--muted);font-size:11px}.vehicle .price{font-size:12px;font-weight:800;color:var(--green);margin-top:7px}
.summary{display:flex;align-items:center;justify-content:space-between;gap:10px}.summary small{display:block;color:var(--muted);font-size:11px}.fare{font-size:23px;font-weight:900;letter-spacing:-.5px}.cta{width:100%;background:var(--green);color:#fff;border-radius:14px;padding:15px;font-weight:900;margin-top:13px;box-shadow:0 7px 18px #00a86b2b}.cta:disabled{opacity:.45;cursor:not-allowed}.hint{font-size:11px;color:var(--muted);margin-top:8px;text-align:center}
nav{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:min(520px,100%);display:flex;justify-content:space-around;background:#fff;border-top:1px solid var(--line);padding:11px 8px calc(11px + env(safe-area-inset-bottom));z-index:1000}nav button{background:transparent;color:#87928b;font-size:10px;font-weight:700;display:grid;gap:3px;justify-items:center}nav button span{font-size:19px}nav button.active{color:var(--green)}
.toast{position:fixed;z-index:2000;bottom:90px;left:50%;transform:translateX(-50%);background:#142a20;color:white;padding:12px 16px;border-radius:12px;font-size:13px;display:none;max-width:90%;text-align:center}
@media(max-width:599px){.location-row{grid-template-columns:12px minmax(0,1fr) 58px}.fields{display:contents}.search-destination{grid-column:3;grid-row:2;width:58px;height:32px;padding:4px 2px;font-size:10px;line-height:1.1;white-space:normal;border-radius:9px;align-self:start;margin-top:4px}.gps{grid-column:3;grid-row:1}.field:first-child{grid-column:2;grid-row:1}.field:nth-child(2){grid-column:2;grid-row:2}}
@media(min-width:600px){body{padding:18px 0}.app{border-radius:24px;overflow:hidden;box-shadow:0 18px 60px #14251d14}}
</style>
</head>
<body>
<div class="app">
<header>
 <div class="top"><div class="brand">GOJEK <span>ELIT</span></div><div class="profile"><div class="avatar">GE</div><div><b id="userName">Pelanggan</b><br><span>Customer</span></div></div></div>
 <div class="greeting">Perjalanan nyaman, lebih praktis</div><div class="headline">Mau pergi ke mana?</div>
</header>
<main>
 <section class="card">
  <div class="section-title">Rute perjalanan <span style="color:var(--green);font-size:11px">● Siap dijemput</span></div>
  <div class="location-row"><div class="dots"><i class="dot"></i><i class="line"></i><i class="dot dest"></i></div>
   <div class="fields"><label class="field">⌖ <input id="pickup" placeholder="Lokasi jemput" value="" autocomplete="street-address"></label><label class="field">⌕ <input id="destination" placeholder="Masukkan alamat tujuan" autocomplete="off"></label><button class="search-destination" id="searchDestinationBtn" type="button">Enter · Cari tujuan</button></div>
   <button class="gps" id="gpsBtn">GPS</button>
  </div>
 </section>
 <section class="card">
  <div class="section-title">Peta perjalanan <span style="font-size:11px;color:var(--muted);font-weight:500">Atur titik jemput</span></div>
  <div class="map-wrap"><div id="map" style="height:100%;width:100%"></div><div class="map-actions"><button id="layerBtn">🛰 Satelit</button><button id="centerBtn">◎ Pusatkan</button></div><div class="map-note">Geser peta untuk memilih lokasi jemput</div></div>
 </section>
 <section class="card">
  <div class="section-title">Pilih layanan</div>
  <div class="vehicles">
   <button class="vehicle active" data-type="motor"><span class="emoji">🏍️</span><strong>GOJEK Motor</strong><small>1 penumpang · cepat</small><div class="price" id="motorPrice">Estimasi Rp —</div></button>
   <button class="vehicle" data-type="mobil"><span class="emoji">🚘</span><strong>GOJEK Mobil</strong><small>Nyaman · hingga 4 orang</small><div class="price" id="carPrice">Estimasi Rp —</div></button>
  </div>
 </section>
 <section class="card">
  <div class="summary"><div><small>Estimasi biaya perjalanan</small><div class="fare" id="fare">Rp —</div></div><div style="text-align:right"><small>Jarak</small><b id="distance">— km</b></div></div>
  <button class="cta" id="orderBtn" disabled>Cari kurir</button><div class="hint">Tarif estimasi. Harga final dapat berubah sesuai kondisi perjalanan.</div>
 </section>
</main>
<nav><button class="active"><span>⌂</span>Beranda</button><button id="historyBtn"><span>◷</span>Pesanan</button><button id="helpBtn"><span>♡</span>Bantuan</button><button id="profileBtn"><span>♙</span>Profil</button></nav>
<div class="toast" id="toast"></div><section id="courierResults" class="card" style="display:none;margin:12px 15px"><div class="section-title">Kurir yang memenuhi saldo 5%</div><div id="courierList"></div><button id="sendEligibleOrder" class="cta" style="display:none;margin-top:12px" disabled>Kirim order ke kurir terpilih</button></section>
</div>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
(()=> {
 const $=id=>document.getElementById(id); let selected='motor',pickupPoint=null,destinationPoint=null,layer='road',map,marker;
 const toast=(msg)=>{const t=$('toast');t.textContent=msg;t.style.display='block';clearTimeout(toast.timer);toast.timer=setTimeout(()=>t.style.display='none',2800)};
 const money=n=>'Rp '+Math.round(n).toLocaleString('id-ID');
 map=L.map('map',{zoomControl:false}).setView([-6.9175,107.6191],13);
 const road=L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'© OpenStreetMap contributors',maxZoom:19});
 const satellite=L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',{attribution:'Tiles © Esri',maxZoom:19});
 road.addTo(map); L.control.zoom({position:'bottomright'}).addTo(map);
 marker=L.marker(map.getCenter(),{draggable:true}).addTo(map); pickupPoint=map.getCenter();
 let routeLine=null,routeBusy=false,routeGeometry=null;
 async function drawRoute(){
   if(!pickupPoint||!destinationPoint){if(routeLine){map.removeLayer(routeLine);routeLine=null}routeGeometry=null;update();return}
   if(routeBusy)return;routeBusy=true;
   try{
     const url=`https://router.project-osrm.org/route/v1/driving/${pickupPoint.lng},${pickupPoint.lat};${destinationPoint.lng},${destinationPoint.lat}?overview=full&geometries=geojson`;
     const response=await fetch(url);const data=await response.json();
     if(!data.routes||!data.routes[0])throw new Error('route unavailable');
     const r=data.routes[0];routeGeometry=r.geometry.coordinates;
     const latlngs=routeGeometry.map(c=>[c[1],c[0]]);
     if(routeLine)map.removeLayer(routeLine);
     routeLine=L.polyline(latlngs,{color:'#00a86b',weight:5,opacity:.9,lineCap:'round'}).addTo(map);
     map.fitBounds(routeLine.getBounds(),{padding:[35,35]});
     $('distance').textContent=(r.distance/1000).toFixed(1)+' km';
     update(r.distance/1000);
   }catch(e){routeGeometry=null;toast('Rute jalan gagal dimuat. Periksa koneksi atau coba lagi.');update()}
   finally{routeBusy=false}
 }
 marker.on('dragend',()=>{pickupPoint=marker.getLatLng();update();drawRoute()});
 map.on('click',e=>{pickupPoint=e.latlng;marker.setLatLng(e.latlng);update();drawRoute()});
 $('layerBtn').onclick=()=>{if(layer==='road'){map.removeLayer(road);satellite.addTo(map);layer='sat';$('layerBtn').textContent='🗺 Jalan'}else{map.removeLayer(satellite);road.addTo(map);layer='road';$('layerBtn').textContent='🛰 Satelit'}};
 $('centerBtn').onclick=()=>map.setView(marker.getLatLng(),15);
 $('gpsBtn').onclick=()=>{if(!navigator.geolocation)return toast('GPS tidak tersedia di perangkat ini.');$('gpsBtn').textContent='Mencari…';navigator.geolocation.getCurrentPosition(pos=>{pickupPoint=L.latLng(pos.coords.latitude,pos.coords.longitude);marker.setLatLng(pickupPoint);map.setView(pickupPoint,16);$('pickup').value=pickupPoint.lat.toFixed(5)+', '+pickupPoint.lng.toFixed(5);$('gpsBtn').textContent='GPS';update();drawRoute();fetch('https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat='+pickupPoint.lat+'&lon='+pickupPoint.lng).then(r=>r.json()).then(d=>{if(d.display_name)$('pickup').value=d.display_name}).catch(()=>{})},()=>{$('gpsBtn').textContent='GPS';toast('Izin lokasi ditolak atau GPS tidak aktif.')},{enableHighAccuracy:true,timeout:12000})};
 const geo=async q=>{if(!q.trim())return null;try{const r=await fetch('https://nominatim.openstreetmap.org/search?format=jsonv2&limit=1&q='+encodeURIComponent(q));const d=await r.json();return d[0]?L.latLng(+d[0].lat,+d[0].lon):null}catch{return null}};
 let destinationSearchBusy=false;
 async function searchDestination(){const q=$('destination').value.trim();if(!q){destinationPoint=null;update();return}if(destinationSearchBusy)return;destinationSearchBusy=true;toast('Mencari alamat tujuan…');const p=await geo(q);destinationSearchBusy=false;if(!p){destinationPoint=null;update();return toast('Alamat belum ditemukan. Tambahkan kecamatan/kota, lalu tekan Enter.')}destinationPoint=p;map.fitBounds(L.latLngBounds(p,pickupPoint),{padding:[35,35]});update();drawRoute();toast('Tujuan ditemukan. Rute jalan sedang dihitung.')}
 $('destination').addEventListener('change',searchDestination);
 $('searchDestinationBtn').onclick=searchDestination;
 $('destination').addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();searchDestination()}});
 $('destination').addEventListener('blur',()=>{if($('destination').value.trim()&&!destinationPoint)searchDestination()});
 $('pickup').addEventListener('change',async()=>{const p=await geo($('pickup').value);if(p){pickupPoint=p;marker.setLatLng(p);map.setView(p,15);update();drawRoute()}else toast('Lokasi jemput tidak ditemukan.')});
 function distanceKm(a,b){const R=6371,dLat=(b.lat-a.lat)*Math.PI/180,dLon=(b.lng-a.lng)*Math.PI/180;const x=Math.sin(dLat/2)**2+Math.cos(a.lat*Math.PI/180)*Math.cos(b.lat*Math.PI/180)*Math.sin(dLon/2)**2;return 2*R*Math.atan2(Math.sqrt(x),Math.sqrt(1-x))}
 function update(routeKm){const valid=pickupPoint&&destinationPoint;let km=valid?(Number.isFinite(routeKm)?routeKm:distanceKm(pickupPoint,destinationPoint)):0;let motor=valid?7000+Math.max(0,km-2)*2500:0,car=valid?12000+Math.max(0,km-2)*4500:0;
 $('distance').textContent=valid?km.toFixed(1)+' km':'— km';$('motorPrice').textContent=valid?money(motor):'Estimasi Rp —';$('carPrice').textContent=valid?money(car):'Estimasi Rp —';$('fare').textContent=valid?money(selected==='motor'?motor:car):'Rp —';$('orderBtn').disabled=!valid||km>40;
 if(km>40) $('orderBtn').textContent='Di luar radius 40 km';else $('orderBtn').textContent='Cari kurir';
 }
 document.querySelectorAll('.vehicle').forEach(btn=>btn.onclick=()=>{selected=btn.dataset.type;document.querySelectorAll('.vehicle').forEach(b=>b.classList.toggle('active',b===btn));update()});
 $('orderBtn').onclick=()=>{if(!pickupPoint||!destinationPoint)return;const km=distanceKm(pickupPoint,destinationPoint);if(km>40)return toast('Tujuan di luar radius pencarian kurir 40 km.');const fare=(selected==='motor'?7000+Math.max(0,km-2)*2500:12000+Math.max(0,km-2)*4500);const order={service:selected,fare,estimated_fare:fare,pickup:$('pickup').value||`${pickupPoint.lat.toFixed(5)}, ${pickupPoint.lng.toFixed(5)}`,destination:$('destination').value,distance_km:+km.toFixed(2),pickup_coordinates:{lat:pickupPoint.lat,lng:pickupPoint.lng},destination_coordinates:{lat:destinationPoint.lat,lng:destinationPoint.lng},route_coordinates:routeGeometry,status:'searching',created_at:new Date().toISOString()};localStorage.setItem('gojek_elit_last_order',JSON.stringify(order));window.dispatchEvent(new CustomEvent('gojek-order-request',{detail:order}))};
 $('historyBtn').onclick=()=>toast(localStorage.getItem('gojek_elit_last_order')?'Pesanan terakhir tersimpan di perangkat.':'Belum ada pesanan.');$('helpBtn').onclick=()=>toast('Hubungi layanan bantuan melalui kanal resmi.');$('profileBtn').onclick=()=>toast('Profil pelanggan');
 update();
})();
</script>

<script type="module">
import {app,auth,db} from './firebase-config.js';
import {onAuthStateChanged} from 'https://www.gstatic.com/firebasejs/12.4.0/firebase-auth.js';
import {collection,getDocs,query,where,addDoc,serverTimestamp} from 'https://www.gstatic.com/firebasejs/12.4.0/firebase-firestore.js';
const $=id=>document.getElementById(id);
let signedUser=null;
onAuthStateChanged(auth,user=>{
 signedUser=user;
 if(user){$('userName').textContent=user.displayName||user.email?.split('@')[0]||'Pelanggan';}
 else {$('userName').textContent='Pelanggan';}
});
let eligibleOrderPayload=null,eligibleCouriers=[];
window.addEventListener('gojek-order-request',async ev=>{
 const payload=ev.detail;if(!signedUser){alert('Silakan login terlebih dahulu.');return;}
 const btn=$('orderBtn'),panel=$('courierResults'),list=$('courierList'),send=$('sendEligibleOrder');
 btn.disabled=true;btn.textContent='Memeriksa kurir…';send.style.display='none';send.disabled=true;list.innerHTML='<div class="hint">Memeriksa kurir online, radius 40 km, dan saldo 5%…</div>';
 try{
  const snap=await getDocs(query(collection(db,'users'),where('role','==','kurir')));
  const fare=Number(payload.estimated_fare||payload.fare||0);if(!(fare>0))throw new Error('Ongkir tidak valid; order tidak dapat dicari.');
  const required=Math.ceil(fare*.05), pickup=payload.pickup_coordinates;
  if(!pickup||!Number.isFinite(Number(pickup.lat))||!Number.isFinite(Number(pickup.lng)) )throw new Error('GPS jemput tidak valid.');
  eligibleCouriers=snap.docs.map(d=>({id:d.id,...d.data()})).map(u=>{
   const lat=Number(u.gps?.lat??u.lokasi?.lat??u.currentLat??u.latitude??u.lat),lng=Number(u.gps?.lng??u.lokasi?.lng??u.currentLng??u.longitude??u.lng);
   const bal=Number(u.saldoEwallet??u.saldoWallet??u.saldo??u.walletBalance??u.deposit??0),online=u.isOnline===true||u.online===true||u.statusOnline===true||u.aktif===true;
   const vehicle=String(u.kendaraan||u.jenisKendaraan||'').toLowerCase();
   if(!online||!Number.isFinite(lat)||!Number.isFinite(lng)||(lat===0&&lng===0)||bal<required||!vehicle.includes(payload.service==='motor'?'motor':'mobil'))return null;
   const rad=Math.PI/180,dlat=(lat-Number(pickup.lat))*rad,dlng=(lng-Number(pickup.lng))*rad,a=Math.sin(dlat/2)**2+Math.cos(Number(pickup.lat)*rad)*Math.cos(lat*rad)*Math.sin(dlng/2)**2;
   return {...u,lat,lng,balance:bal,km:6371*2*Math.atan2(Math.sqrt(a),Math.sqrt(1-a))};
  }).filter(u=>u&&u.km<=40).sort((a,b)=>a.km-b.km);
  eligibleOrderPayload={...payload,fare,required};panel.style.display='block';
  if(!eligibleCouriers.length){list.innerHTML=`<div class="err">Tidak ada kurir layak dalam radius 40 km dengan saldo minimal Rp ${required.toLocaleString('id-ID')}.</div>`;return;}
  list.innerHTML=eligibleCouriers.map((u,i)=>`<label style="display:flex;gap:10px;align-items:center;border:1px solid #e7eee9;border-radius:12px;padding:12px;margin:7px 0;background:${i===0?'#effaf4':'#fff'}"><input type="checkbox" class="eligibleCourier" value="${u.id}" ${i===0?'checked':''}><span><b>${i===0?'⭐ Terdekat · ':''}${String(u.nama||u.namaUsaha||u.email||u.id).replace(/[&<>\"]/g,'')}</b><div class="meta">${u.km.toFixed(2)} km · Saldo Rp ${u.balance.toLocaleString('id-ID')} · Minimal Rp ${required.toLocaleString('id-ID')}</div></span></label>`).join('');
  send.style.display='block';send.disabled=false;send.textContent='Kirim order ke kurir terpilih ('+eligibleCouriers.length+')';
 }catch(err){list.innerHTML=`<div class="err">${String(err.message||err).replace(/[&<>\"]/g,'')}</div>`;alert('Gagal mencari kurir: '+(err.message||err));}
 finally{btn.disabled=false;btn.textContent='Cari kurir';}
});
$('sendEligibleOrder').onclick=async()=>{
 const payload=eligibleOrderPayload;if(!payload||!signedUser)return;const selectedIds=[...document.querySelectorAll('.eligibleCourier:checked')].map(x=>x.value);if(!selectedIds.length){alert('Pilih minimal satu kurir yang layak.');return;}
 const send=$('sendEligibleOrder');send.disabled=true;send.textContent='Mengirim order…';
 try{
  const chosen=eligibleCouriers.filter(c=>selectedIds.includes(c.id));
  const route=Array.isArray(payload.route_coordinates)?payload.route_coordinates.map(c=>({lat:Number(c[1]),lng:Number(c[0])})).filter(c=>Number.isFinite(c.lat)&&Number.isFinite(c.lng)):[];
  const order={pelangganUid:signedUser.uid,uid:signedUser.uid,ownerUid:signedUser.uid,kurirUid:chosen[0].uid||chosen[0].id,kurirTargetUid:chosen[0].uid||chosen[0].id,kurirPilihanUids:chosen.map(c=>c.uid||c.id),
   jenisKendaraan:payload.service==='motor'?'motor':'mobil',status:'mencari_kurir',statusPemenuhan:'mencari_kurir',alamatJemput:payload.pickup,alamatTujuan:payload.destination,
   titikJemput:{lat:Number(payload.pickup_coordinates.lat),lng:Number(payload.pickup_coordinates.lng)},titikTujuan:{lat:Number(payload.destination_coordinates.lat),lng:Number(payload.destination_coordinates.lng)},rute:route,jarakKm:Number(payload.distance_km||0),ongkir:payload.fare,total:payload.fare,depositKurirDibutuhkan:payload.required,createdAt:serverTimestamp(),created_at:new Date().toISOString()};
  const ref=await addDoc(collection(db,'orders'),order);$('courierList').innerHTML+=`<div class="ok">Order terkirim ke ${chosen.length} kurir terpilih yang memenuhi syarat. ID: ${ref.id}</div>`;alert('Order berhasil dikirim ke kurir terpilih.');
 }catch(err){alert('Gagal mengirim order: '+(err.message||err));}finally{send.disabled=false;send.textContent='Kirim order ke kurir terpilih';}
};
</script>

</body>
</html>
